[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[submodule]
	active = .
[remote "origin"]
	url = https://github.com/jasonamaral/mba.modulo3.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[gitflow "branch"]
	master = main
	develop = develop
[gitflow "prefix"]
	feature = feature/
	bugfix = bugfix/
	release = release/
	hotfix = hotfix/
	support = support/
	versiontag = 
[gitflow "path"]
	hooks = C:/Users/Jason/Documents/MBA/Modulo3/.git/hooks
[branch "feature/primeira_entrega"]
	remote = origin
	merge = refs/heads/feature/primeira_entrega
[branch "develop"]
	remote = origin
	merge = refs/heads/develop
[branch "feature/segunda_entrega"]
	remote = origin
	merge = refs/heads/feature/segunda_entrega
	vscode-merge-base = origin/develop
